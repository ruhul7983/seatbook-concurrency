generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  ATTENDEE
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
  RELEASED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ATTENDEE)
  events       Event[]
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  venue       String
  startsAt    DateTime
  rows        Int
  cols        Int
  priceCents  Int
  organizerId Int
  organizer   User     @relation(fields: [organizerId], references: [id])
  seats       Seat[]
  createdAt   DateTime @default(now())
}

model Seat {
  id       Int       @id @default(autoincrement())
  eventId  Int
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row      Int
  col      Int
  label    String
  bookings Booking[]

  @@unique([eventId, row, col])
}

// The live seat lock for a hold lives in Redis. This table is the record of every hold and booking.
//
// The migration 20261026000100_booking_holds also adds a partial unique index that Prisma cannot
// express here: at most one CONFIRMED booking per seat ("Booking_seatId_confirmed_key").
// Prisma 5.22 does not try to drop it; check generated migrations for that after upgrading Prisma.
model Booking {
  id          Int           @id @default(autoincrement())
  seatId      Int
  seat        Seat          @relation(fields: [seatId], references: [id])
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  status      BookingStatus @default(CONFIRMED)
  holdToken   String?       @unique
  expiresAt   DateTime?
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  @@index([status, expiresAt])
}
